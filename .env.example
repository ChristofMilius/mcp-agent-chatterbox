# ============================================================================
# mcp-agent-chatterbox configuration
# ============================================================================
# Copy this file to `.env` and edit it. The server reads `.env` at startup, so
# this is the ONE place these settings need to live: LM Studio, Hermes and
# opencode all pick it up without either harness having to forward anything.
#
# Precedence: a variable already set in the real environment is NEVER
# overridden by this file. That means a one-off `CHATTERBOX_MODEL=turbo` in a
# shell, or a test's monkeypatch, still wins. The file holds the durable value.
#
# Windows note: use FORWARD SLASHES in path values. Relative paths resolve
# against the project root (the repo directory), never the process CWD.
# ============================================================================

# ----------------------------------------------------------------------------
# Model and voice
# ----------------------------------------------------------------------------
# Which model a speak() call uses when it does not name one.
#   nano          110M, English, built-in voice, inline tags. House default:
#                 turbo's quality at a third of the size, also CPU-capable.
#   turbo         350M, English, built-in voice, inline tags.
#   multilingual  500M, 23 languages. REQUIRES a reference clip.
#   original      500M, English, CFG/exaggeration tuning. REQUIRES a clip.
CHATTERBOX_MODEL=nano

# Default reference clip: a filename stem from the voices directory. Used when
# a speak() call names neither voice= nor reference_clip=. Applies to every
# model, including turbo/nano, whose built-in voice is only the fallback when
# none is configured. A name that does not exist fails fast with
# voice_not_found rather than silently rendering in another voice.
# Leave blank to use each model's own voice.
CHATTERBOX_VOICE=

# ----------------------------------------------------------------------------
# Hugging Face cache
# ----------------------------------------------------------------------------
# Set HF_HOME before huggingface_hub is imported, so the multi-GB download
# lands here instead of C:\Users\<you>\.cache\huggingface. Absolute path.
# Leave blank for HF's own default.
CHATTERBOX_HF_HOME=

# ----------------------------------------------------------------------------
# Device selection
# ----------------------------------------------------------------------------
# "auto" (default) picks the CUDA card with the most free VRAM at load time.
# Also accepts "cpu", "cuda", or "cuda:N".
CHATTERBOX_DEVICE=auto

# Pin a specific CUDA ordinal, overriding the "auto" heuristic above. This is
# the setting to reach for when you know which card LM Studio is NOT on.
# Leave blank (or unset) to let "auto" choose. Equivalent to CHATTERBOX_DEVICE
# being set to "cuda:N"; if you set both, the explicit DEVICE value wins.
CHATTERBOX_GPU_INDEX=

# Free-VRAM floor (MiB) for a load attempt, and whether falling below it warns
# (0, default) or refuses outright (1).
CHATTERBOX_VRAM_MB=4096
CHATTERBOX_STRICT_VRAM=0

# ----------------------------------------------------------------------------
# Speech queue and output
# ----------------------------------------------------------------------------
# Play each sentence chunk as it finishes rendering. This only decides whether
# audio comes out; the chunks are written either way.
CHATTERBOX_AUTOPLAY=1

# Where the chunk WAVs are written. Relative values resolve against the
# project root.
CHATTERBOX_OUTPUT_DIR=tts_output

# Where reference clips live.
CHATTERBOX_VOICES_DIR=voices

# Rotating log file location.
CHATTERBOX_LOGS_DIR=logs

# ----------------------------------------------------------------------------
# Text limits
# ----------------------------------------------------------------------------
# Reject a single speak() request longer than this many characters.
CHATTERBOX_MAX_CHARS=4000

# Hard cap for ONE sentence. Text is split one sentence per chunk; this only
# bounds the exception, a sentence so long it has to be broken. Chatterbox
# truncates large inputs, so a chunk must never exceed this.
CHATTERBOX_MAX_CHUNK_CHARS=500

# Silence in ms inserted between consecutive played chunks.
CHATTERBOX_CHUNK_PAUSE_MS=250

# ----------------------------------------------------------------------------
# Resident worker
# ----------------------------------------------------------------------------
# The MCP server does NOT synthesize. It hands the text to a separate,
# long-lived worker process and waits for the result. The worker is where the
# model stays loaded and where the audio is rendered and played.
#
# Why: synthesis inside the MCP server process reliably stopped after two
# sentences and never resumed, over both the stdio and the HTTP transport,
# while the same code outside a server finished the whole reply. A separate
# process is also the only way the audio survives the end of a chat turn: the
# server dies with its turn, the worker does not.
#
# Start one before your first spoken reply, and leave it running:
#     mcp-agent-chatterbox worker
# Check on it:
#     mcp-agent-chatterbox worker-status
# Stop it (it finishes the queue first):
#     mcp-agent-chatterbox worker-stop
#
# Loopback port the worker listens on. The server and the worker must agree;
# they read this same value. If nothing is listening, speak() reports
# worker_not_running rather than failing silently.
CHATTERBOX_WORKER_PORT=8765

# Seconds to wait for a connection to the worker before giving up. This bounds
# the CONNECT only -- never the reply, which takes as long as the speech takes.
# A refused connection on loopback is immediate, so this is generous already.
CHATTERBOX_WORKER_CONNECT_TIMEOUT=5
