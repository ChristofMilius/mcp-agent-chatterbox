# Ignore everything by default
*

# Whitelist: un-ignore exactly what is versioned
!.gitignore
!/.python-version
!/.env.example
!/LICENSE
!/README.md
!/pyproject.toml
!/uv.lock
!/src/
!/src/**
!/tests/
!/tests/**
!/.opencode/
!/.opencode/plugins/
!/.opencode/plugins/**
!/.opencode/commands/
!/.opencode/commands/**
!/skills/
!/skills/**

# Never commit real output, model weights or reference voices.
/tts_output/
/voices/
/logs/
*.wav
*.mp3
*.flac
*.pt
*.safetensors

# Local settings, never versioned. The leading `*` already excludes this, but
# it is re-ignored after the un-ignores above so a future whitelist edit
# cannot sweep real machine values into the index. Ship .env.example instead.
/.env

# Re-ignore generated artifacts. These come AFTER the !/src/** and !/tests/**
# un-ignores above on purpose: a whitelist entry like !/src/** re-includes
# everything beneath it, byte-compiled caches included, and gitignore resolves
# ties by last match. Without these lines, a plain `git add .` stages .pyc
# files -- which is exactly the failure a whitelist-first setup is meant to
# make impossible.
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
